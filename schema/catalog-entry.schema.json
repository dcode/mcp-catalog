{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dcode/mcp-catalog/schema/catalog-entry.schema.json",
  "title": "Obot MCP catalog entry (dcode/mcp-catalog conventions)",
  "description": "One MCPServerCatalogEntryManifest as read by Obot v0.28.2 git catalog sync. Obot itself ignores unknown fields; this schema is stricter on purpose so typos and legacy fields (serverUserType, env, remoteConfig.headers, multiUserConfig) fail in CI. Only runtime: remote is modelled; extend the schema before adding other runtimes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "entryKey",
    "shortDescription",
    "description",
    "icon",
    "repoURL",
    "runtime",
    "remoteConfig"
  ],
  "properties": {
    "type": {
      "description": "Omitted or 'entry' for a catalog entry. vMCP items (type: vmcp) use a different schema.",
      "const": "entry"
    },
    "name": {
      "description": "Display name. Also determines the Obot object ID, so it must be unique across every catalog source (including Obot's default catalog).",
      "type": "string",
      "minLength": 1,
      "pattern": "[A-Za-z0-9]"
    },
    "entryKey": {
      "description": "Stable key, unique within this source. DNS-1123 subdomain. Must start with an allowed prefix (see docs/catalog-entry-spec.md).",
      "type": "string",
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
    },
    "shortDescription": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "description": "Markdown. Must link to official docs before the first '## ' heading.",
      "type": "string",
      "minLength": 1
    },
    "icon": {
      "description": "Public https URL rendered as <img src>. Must not depend on this repo being public.",
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "repoURL": {
      "description": "Link to the official documentation.",
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "categories": {
          "description": "Comma-separated, free text. 'Official' is stripped on sync.",
          "type": "string"
        },
        "unsupportedTools": {
          "description": "Comma-separated tool names that are unselected by default.",
          "type": "string"
        },
        "allow-multiple": {
          "enum": ["true", "false"]
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "toolPreview": {
      "description": "Display-only tool list. Generated by scripts/tool_preview.py; do not edit by hand.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/toolPreviewItem"
      }
    },
    "upgradeNote": {
      "type": "string"
    },
    "minObotVersion": {
      "$ref": "#/$defs/obotVersion"
    },
    "maxObotVersion": {
      "$ref": "#/$defs/obotVersion"
    },
    "runtime": {
      "description": "Only 'remote' is supported by this repo's schema today. Obot also accepts uvx, npx, containerized and openapi.",
      "const": "remote"
    },
    "remoteConfig": {
      "$ref": "#/$defs/remoteConfig"
    },
    "config": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/configField"
      }
    },
    "injectObotHeaders": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^X-Obot-[A-Za-z-]+$"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "obotVersion": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "toolPreviewItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "remoteConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fixedURL": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "urlTemplate": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "staticOAuthRequired": {
          "type": "boolean"
        },
        "localhostCallbackEnabled": {
          "type": "boolean"
        },
        "localhostCallbackPath": {
          "type": "string",
          "pattern": "^/"
        }
      },
      "oneOf": [
        {"required": ["fixedURL"]},
        {"required": ["hostname"]},
        {"required": ["urlTemplate"]}
      ]
    },
    "configField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "usage"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "usage": {
          "enum": ["env", "header", "file", "dynamicFile", "interpolated"]
        },
        "required": {
          "type": "boolean"
        },
        "sensitive": {
          "type": "boolean"
        },
        "value": {
          "type": "string"
        },
        "prefix": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value"],
            "properties": {
              "name": {"type": "string"},
              "value": {"type": "string"},
              "description": {"type": "string"}
            }
          }
        },
        "secretBinding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "key"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "key": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
